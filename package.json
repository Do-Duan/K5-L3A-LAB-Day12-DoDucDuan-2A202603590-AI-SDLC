{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs",
    "build": "tsc -b && vite build",
    "start": "node scripts/start.mjs",
    "headless": "tsx src/headless.ts",
    "test": "tsx tests/phase3/run.ts && tsx tests/phase4/run.ts",
    "test:phase3": "tsx tests/phase3/run.ts",
    "test:phase4": "tsx tests/phase4/run.ts",
    "bench": "node scripts/bench.mjs",
    "soak": "node --expose-gc --import tsx scripts/soak.ts",
    "test:e2e": "node tests/phase4/e2e.mjs",
    "package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "puppeteer-core": "^24.0.0"
  }
}
